# Bajaj Enterprises Environment Configuration
ENVIRONMENT=development
PROJECT_NAME="Bajaj Enterprises Bicycles"
VERSION="1.0.0"
API_V1_STR="/api/v1"

# Security (Change in production!)
# Leave unset for local development; production requires a unique random value (32+ chars).
# SECRET_KEY=
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Database Configuration
# For local SQLite development/testing:
DATABASE_URL="sqlite:///./bajaj_enterprises.db"
# For local or production MySQL 8.0:
# DATABASE_URL="mysql+pymysql://root:yourpassword@127.0.0.1:3306/bajaj_enterprises?charset=utf8mb4"

# Uploads Configuration
UPLOAD_DIR="uploads"
MAX_UPLOAD_SIZE_MB=10
MAX_REQUEST_SIZE_MB=12
MAX_IMPORT_ROWS=10000
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT_SECONDS=30
DB_POOL_RECYCLE_SECONDS=1800

# CORS Allowed Origins
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173","http://localhost:3000","https://bajajenterprises.vercel.app"]

# Store Information (Defaults for Bajaj Enterprises Bikaner)
STORE_NAME="Bajaj Enterprises"
STORE_ADDRESS="Alakh Sagar Road, Kote Gate, Bikaner, Rajasthan 334001, India"
STORE_PHONE=""
STORE_WHATSAPP=""
STORE_EMAIL=""

# Email SMTP Settings (Leave blank or set to test mode if not configured)
SMTP_HOST=""
SMTP_PORT=587
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_FROM_EMAIL="noreply@bajajenterprises.local"
SMTP_ENABLED=false
